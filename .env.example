# Supabase връзка
SUPABASE_URL=https://lvgdvibtcyhpoyuyqyln.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Service role ключ — нужен САМО за качване на данни (заобикаля RLS).
# Вземи го от Supabase: Project Settings -> API -> service_role.
# ВНИМАНИЕ: таен ключ, никога не го качвай в git!
SUPABASE_SERVICE_KEY=your-service-role-key-here

# OpenAI (платеният ти ключ) — таен!
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-4o
