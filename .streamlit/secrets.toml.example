# Примерен Streamlit secrets файл.
#
# При ДЕПЛОЙ (Streamlit Community Cloud): не качвай този файл — копирай
# съдържанието в App -> Settings -> Secrets.
# ЛОКАЛНО: копирай го като .streamlit/secrets.toml и попълни тайния ключ.
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# ВНИМАНИЕ: secrets.toml (с реалния ключ) е в .gitignore — НИКОГА не го качвай в git!

# Парола за достъп до приложението. БЕЗ нея приложението е отворено за всеки
# с линка — затова на деплой я задай задължително.
APP_PASSWORD = "избери-силна-парола"

# Тайният service_role ключ — нужен за четене/качване/редакция (заобикаля RLS).
# Вземи го от Supabase: Project Settings -> API -> service_role.
SUPABASE_SERVICE_KEY = "your-service-role-key-here"

# OpenAI ключ за чат асистента (също таен).
OPENAI_API_KEY = "your-openai-key-here"

# По избор (имат стойности по подразбиране в config.py):
# SUPABASE_URL = "https://lvgdvibtcyhpoyuyqyln.supabase.co"
# SUPABASE_ANON_KEY = "..."
# OPENAI_MODEL = "gpt-4o"
